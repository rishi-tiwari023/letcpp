        <h1>LeetCode 1464: Maximum Product of Two Elements in an Array (C++)</h1>
        <div class="problem-description">
            <p><strong>Problem:</strong>
                Given the array of integers nums, find the maximum value of (nums[i]-1)*(nums[j]-1) for distinct indices
                i and j.
            </p>
            <p><strong>Example:</strong>
                Input: nums = [3,4,5,2]<br>
                Output: 12<br>
                Explanation: The two largest values are 5 and 4. (5-1)*(4-1) = 4*3 = 12.
            </p>
        </div>
        <div class="code-container">
            <button class="copy-button" onclick="copyCode(this)">Copy Code</button>
            <pre><code class="language-cpp">class Solution {
public:
    int maxProduct(vector&lt;int&gt;&amp; arr) {
        int first = INT_MIN, second = INT_MIN;

        for (int val : arr) {
            if (val &gt; first) {
                second = first;
                first = val;
            } else if (val &gt; second) {
                second = val;
            }
        }

        return (first - 1) * (second - 1);
    }
};</code></pre>
