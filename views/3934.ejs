        <h1>LeetCode 3934: Smallest Unique Subarray (C++)</h1>
        <div class="problem-description">
            <p><strong>Problem:</strong>
                Given an integer array nums, find the minimum length of a subarray that is not identical to any
                other subarray in nums. Two subarrays are identical if they have the same length and the same
                elements in corresponding positions. Return the minimum possible length.
            </p>
            <p><strong>Example 1:</strong>
                Input: nums = [3,3,3]<br>
                Output: 3<br>
                Explanation: The subarrays of lengths 1 and 2 repeat, while [3,3,3] appears once.
            </p>
            <p><strong>Example 2:</strong>
                Input: nums = [2,1,2,3,3]<br>
                Output: 1<br>
                Explanation: The subarray [1] appears once.
            </p>
            <p><strong>Example 3:</strong>
                Input: nums = [1,1,2,2,1]<br>
                Output: 2<br>
                Explanation: All length-1 subarrays repeat, and a length-2 subarray such as [1,1] appears once.
            </p>
            <p><strong>Constraints:</strong>
                1 &lt;= nums.length &lt;= 10<sup>5</sup><br>
                1 &lt;= nums[i] &lt;= 10<sup>5</sup>
            </p>
        </div>
        <div class="code-container">
            <button class="copy-button" onclick="copyCode(this)">Copy Code</button>
            <pre><code class="language-cpp">class Solution {
public:
    int smallestUniqueSubarray(vector&lt;int&gt;&amp; nums) {
        int n = nums.size();
        int m = *max_element(nums.begin(), nums.end()) + 1;
        vector&lt;int&gt; sa(n), rk(nums), old(n), tmp(n), cnt(max(m, n) + 1, 0);

        for (int i = 0; i &lt; n; i++) cnt[rk[i]]++;
        for (int i = 1; i &lt; m; i++) cnt[i] += cnt[i - 1];
        for (int i = n - 1; i &gt;= 0; i--) sa[--cnt[rk[i]]] = i;

        for (int k = 1;; k &lt;&lt;= 1) {
            int p = 0;

            for (int i = max(0, n - k); i &lt; n; i++) tmp[p++] = i;
            for (int i = 0; i &lt; n; i++)
                if (sa[i] &gt;= k) tmp[p++] = sa[i] - k;

            fill(cnt.begin(), cnt.begin() + m, 0);

            for (int i = 0; i &lt; n; i++) cnt[rk[i]]++;
            for (int i = 1; i &lt; m; i++) cnt[i] += cnt[i - 1];
            for (int i = n - 1; i &gt;= 0; i--)
                sa[--cnt[rk[tmp[i]]]] = tmp[i];

            old = rk;
            rk[sa[0]] = 0;
            p = 1;

            for (int i = 1; i &lt; n; i++) {
                int a = sa[i - 1], b = sa[i];
                int x = a + k &lt; n ? old[a + k] : -1;
                int y = b + k &lt; n ? old[b + k] : -1;

                rk[b] = (old[a] == old[b] &amp;&amp; x == y) ? p - 1 : p++;
            }

            if (p == n) break;
            m = p;
        }

        vector&lt;int&gt; lcp(n + 1, 0);

        for (int i = 0, h = 0; i &lt; n; i++) {
            if (rk[i] == 0) {
                h = 0;
                continue;
            }

            int j = sa[rk[i] - 1];

            while (i + h &lt; n &amp;&amp; j + h &lt; n &amp;&amp; nums[i + h] == nums[j + h])
                h++;

            lcp[rk[i]] = h;
            if (h &gt; 0) h--;
        }

        int ans = n;

        for (int i = 0; i &lt; n; i++) {
            int mx = max(lcp[i], i + 1 &lt; n ? lcp[i + 1] : 0);

            if (mx + 1 &lt;= n - sa[i])
                ans = min(ans, mx + 1);
        }

        return ans;
    }
};</code></pre>
