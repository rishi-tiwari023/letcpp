        <h1>LeetCode 1520: Maximum Number of Non-Overlapping Substrings (C++)</h1>
        <div class="problem-description">
            <p><strong>Problem:</strong>
                Given a string s of lowercase letters, return the maximum number of non-empty substrings of s
                that can be extracted such that the two conditions are met: the substrings do not overlap,
                and each occurrence of a letter in s must lie within exactly one of the chosen substrings. If
                there are multiple solutions with the same number of substrings, return the one with minimum
                total length. It can be shown that there exists a unique solution of minimum total length.
            </p>
            <p><strong>Example:</strong>
                Input: s = "adefaddaccc"<br>
                Output: ["e","f","ccc"]<br>
                Explanation: Choosing "e", "f", and "ccc" covers every occurrence of those letters without
                overlap, and gives more substrings than any other valid choice.
            </p>
        </div>
        <div class="code-container">
            <button class="copy-button" onclick="copyCode(this)">Copy Code</button>
            <pre><code class="language-cpp">class Solution {
public:
    vector&lt;string&gt; maxNumOfSubstrings(string s) {
        int len = s.size();

        vector&lt;int&gt; start(26, len);
        vector&lt;int&gt; finish(26, -1);

        for (int i = 0; i &lt; len; i++) {
            int idx = s[i] - 'a';
            start[idx] = min(start[idx], i);
            finish[idx] = i;
        }

        vector&lt;pair&lt;int, int&gt;&gt; ranges;

        for (int ch = 0; ch &lt; 26; ch++) {
            if (finish[ch] == -1) continue;

            int left = start[ch];
            int right = finish[ch];
            bool possible = true;

            for (int pos = left; pos &lt;= right; pos++) {
                int idx = s[pos] - 'a';

                if (start[idx] &lt; left) {
                    possible = false;
                    break;
                }

                right = max(right, finish[idx]);
            }

            if (possible) ranges.push_back({right, left});
        }

        sort(ranges.begin(), ranges.end());

        vector&lt;string&gt; result;
        int lastEnd = -1;

        for (auto [right, left] : ranges) {
            if (left &gt; lastEnd) {
                result.push_back(s.substr(left, right - left + 1));
                lastEnd = right;
            }
        }

        return result;
    }
};</code></pre>
