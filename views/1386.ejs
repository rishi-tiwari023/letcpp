        <h1>LeetCode 1386: Cinema Seat Allocation (C++)</h1>
        <div class="problem-description">
            <p><strong>Problem:</strong>
                A cinema has n rows and 10 seats per row (columns 1-10). Some seats are reserved. A family of four must
                sit in 4 consecutive middle seats (columns 2-5, 4-7, or 6-9). Return the maximum number of 4-person
                families that can be seated.
            </p>
            <p><strong>Example:</strong>
                Input: n = 3, reservedSeats = [[1,2],[1,3],[1,8],[2,6],[3,1],[3,10]]<br>
                Output: 4<br>
                Explanation: Rows with no reserved middle seats can fit 2 families each. Rows with some reserved seats
                are checked for each valid block (2-5, 4-7, 6-9) greedily.
            </p>
        </div>
        <div class="code-container">
            <button class="copy-button" onclick="copyCode(this)">Copy Code</button>
            <pre><code class="language-cpp">class Solution {
public:
    int maxNumberOfFamilies(int n, vector&lt;vector&lt;int&gt;&gt;&amp; reservedSeats) {
        map&lt;int, vector&lt;int&gt;&gt; rows;
        for (auto seat : reservedSeats) {
            rows[seat[0]].push_back(seat[1]);
        }
        int result = (n - rows.size()) * 2;
        for (auto row : rows) {
            unordered_map&lt;int, int&gt; occupied;
            for (auto seat : row.second) {
                occupied[seat]++;
            }
            if (!occupied[2] &amp;&amp; !occupied[3] &amp;&amp;
                !occupied[4] &amp;&amp; !occupied[5]) {
                occupied[4]++;
                occupied[5]++;
                result++;
            }
            if (!occupied[4] &amp;&amp; !occupied[5] &amp;&amp;
                !occupied[6] &amp;&amp; !occupied[7]) {
                occupied[6]++;
                occupied[7]++;
                result++;
            }
            if (!occupied[6] &amp;&amp; !occupied[7] &amp;&amp;
                !occupied[8] &amp;&amp; !occupied[9]) {
                result++;
            }
        }
        return result;
    }
};</code></pre>
