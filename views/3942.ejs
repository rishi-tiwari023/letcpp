        <h1>LeetCode 3942: Minimum Operations to Sort a Permutation (C++)</h1>
        <div class="problem-description">
            <p><strong>Problem:</strong>
                You are given an integer array nums of length n, which is a permutation of the integers from
                0 to n - 1. You may use only two operations: reversing the entire array, or rotating it left
                by one position (moving the first element to the end). Find the minimum number of operations
                needed to sort the array in increasing order, or return -1 if sorting is impossible with
                these operations.
            </p>
            <p><strong>Example:</strong>
                Input: nums = [0,2,1]<br>
                Output: 2<br>
                Explanation: Rotating left gives [2,1,0], and reversing gives [0,1,2].
            </p>
        </div>
        <div class="code-container">
            <button class="copy-button" onclick="copyCode(this)">Copy Code</button>
            <pre><code class="language-cpp">class Solution {
public:
    int minOperations(vector&lt;int&gt;&amp; nums) {
        int n = nums.size();
        int idx = 0;

        while (idx &lt; n &amp;&amp; nums[idx] != 0) {
            idx++;
        }

        for (int i = 0; i &lt; n; i++) {
            if (i != nums[(idx + i) % n]) {
                break;
            } else if (i == n - 1) {
                return min(idx, n - idx + 2);
            }
        }

        idx = 0;

        while (idx &lt; n &amp;&amp; nums[idx] != n - 1) {
            idx++;
        }

        for (int i = 0; i &lt; n; i++) {
            if (n - 1 - i != nums[(idx + i) % n]) {
                return -1;
            } else if (i == n - 1) {
                return min(n - idx + 1, idx + 1);
            }
        }

        return -1;
    }
};</code></pre>
