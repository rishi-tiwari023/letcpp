        <h1>LeetCode 2948: Make Lexicographically Smallest Array by Swapping Elements (C++)</h1>
        <div class="problem-description">
            <p><strong>Problem:</strong>
                Given an integer array nums and an integer limit, you can swap any two elements nums[i] and nums[j] if
                |nums[i] - nums[j]| &lt;= limit. Return the lexicographically smallest array achievable after any number
                of such swaps.
            </p>
            <p><strong>Example:</strong>
                Input: nums = [1,5,3,9,8], limit = 2<br>
                Output: [1,3,5,8,9]<br>
                Explanation: Elements within limit of each other can be swapped freely within their group. Sorting each
                group's indices and assigning sorted values yields the lexicographically smallest result.
            </p>
        </div>
        <div class="code-container">
            <button class="copy-button" onclick="copyCode(this)">Copy Code</button>
            <pre><code class="language-cpp">class Solution {
public:
    vector&lt;int&gt; lexicographicallySmallestArray(vector&lt;int&gt;&amp; nums, int limit) {
        int n = nums.size();
        vector&lt;pair&lt;int, int&gt;&gt; pairs(n);
        for (int i = 0; i &lt; n; i++) {
            pairs[i] = {nums[i], i};
        }
        sort(pairs.begin(), pairs.end());
        int start = 0;
        vector&lt;int&gt; order(n);
        order[0] = pairs[0].second;
        for (int i = 1; i &lt; n; i++) {
            if (abs(pairs[i].first - pairs[i - 1].first) &gt; limit) {
                sort(order.begin() + start, order.begin() + i);
                start = i;
            }
            order[i] = pairs[i].second;
        }
        sort(order.begin() + start, order.end());
        vector&lt;int&gt; result(n);
        for (int i = 0; i &lt; n; i++) {
            result[order[i]] = pairs[i].first;
        }
        return result;
    }
};</code></pre>
