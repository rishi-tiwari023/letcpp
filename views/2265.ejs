        <h1>LeetCode 2265: Count Nodes Equal to Average of Subtree (C++)</h1>
        <div class="problem-description">
            <p><strong>Problem:</strong>
                Given the root of a binary tree, return the number of nodes where the value of the node is
                equal to the average (rounded down to the nearest integer) of the values of every node in its
                subtree, including the node itself.
            </p>
            <p><strong>Example:</strong>
                Input: root = [4,8,5,0,1,null,6]<br>
                Output: 5<br>
                Explanation: For each node, compute the average of its subtree; five of the nodes' values
                equal their respective subtree averages.
            </p>
        </div>
        <div class="code-container">
            <button class="copy-button" onclick="copyCode(this)">Copy Code</button>
            <pre><code class="language-cpp">class Solution {
    using Pair = pair&lt;int, int&gt;;

public:
    int answer = 0;

    Pair dfs(TreeNode* root) {
        if (root == nullptr) return {0, 0};

        auto [leftSum, leftCount] = dfs(root-&gt;left);
        auto [rightSum, rightCount] = dfs(root-&gt;right);

        int subtreeSum = root-&gt;val + leftSum + rightSum;
        int subtreeCount = 1 + leftCount + rightCount;

        if (subtreeSum / subtreeCount == root-&gt;val) {
            answer++;
        }

        return {subtreeSum, subtreeCount};
    }

    int averageOfSubtree(TreeNode* root) {
        dfs(root);
        return answer;
    }
};</code></pre>
