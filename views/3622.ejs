    <main>
        <h1>LeetCode 3622: Check Divisibility by Digit Sum and Product (C++)</h1>
        <div class="problem-description">
            <p><strong>Problem:</strong>
                Given a positive integer num, return true if num is divisible by the sum of its digit sum and digit
                product, otherwise return false.
            </p>
            <p><strong>Example:</strong>
                Input: num = 99<br>
                Output: true<br>
                Explanation: Digit sum = 9+9 = 18, digit product = 9*9 = 81. Sum + product = 99. Since 99 % 99 == 0,
                return true.
            </p>
        </div>
        <div class="code-container">
            <button class="copy-button" onclick="copyCode(this)">Copy Code</button>
            <pre><code class="language-cpp">class Solution {
public:
    bool checkDivisibility(int num) {
        int digitSum = 0;
        int digitProduct = 1;
        int value = num;
        while (value &gt; 0) {
            int digit = value % 10;
            value /= 10;
            digitSum += digit;
            digitProduct *= digit;
        }
        return num % (digitSum + digitProduct) == 0;
    }
};</code></pre>
