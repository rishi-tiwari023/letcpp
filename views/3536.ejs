    <main>
        <h1>LeetCode 3536: Maximum Product of Two Digits (C++)</h1>
        <div class="problem-description">
            <p><strong>Problem:</strong>
                Given a positive integer n, return the maximum product obtainable by multiplying any two digits present
                in n.
            </p>
            <p><strong>Example:</strong>
                Input: n = 924<br>
                Output: 36<br>
                Explanation: The digits are 9, 2, and 4. The two largest digits are 9 and 4, whose product is 36.
            </p>
        </div>
        <div class="code-container">
            <button class="copy-button" onclick="copyCode(this)">Copy Code</button>
            <pre><code class="language-cpp">class Solution {
public:
    int maxProduct(int n) {
        int best = -1;
        int runnerUp = -1;
        while (n) {
            int currentDigit = n % 10;
            if (currentDigit &gt;= best) {
                runnerUp = best;
                best = currentDigit;
            } else if (currentDigit &gt;= runnerUp) {
                runnerUp = currentDigit;
            }
            n /= 10;
        }
        return best * runnerUp;
    }
};</code></pre>
