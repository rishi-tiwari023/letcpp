        <h1>LeetCode 3483: Unique 3-Digit Even Numbers (C++)</h1>
        <div class="problem-description">
            <p><strong>Problem:</strong>
                You are given an array of digits. Find all the unique integers that follow these
                requirements: the integer consists of exactly 3 elements from digits, the integer does not
                have leading zeros, and the integer is even. Each digit in digits can be used at most once in
                each integer. Return the count of such unique integers.
            </p>
            <p><strong>Example:</strong>
                Input: digits = [2,1,3,0]<br>
                Output: 18<br>
                Explanation: The 18 possible integers include 102, 130, 132, 210, 230, and others formed the
                same way while satisfying the no-leading-zero and even constraints.
            </p>
        </div>
        <div class="code-container">
            <button class="copy-button" onclick="copyCode(this)">Copy Code</button>
            <pre><code class="language-cpp">class Solution {
public:
    int totalNumbers(vector&lt;int&gt;&amp; digits) {
        int frequency[10] = {0};

        for (int digit : digits) {
            frequency[digit]++;
        }

        int answer = 0;

        for (int first = 1; first &lt;= 9; first++) {
            if (frequency[first] == 0) continue;
            frequency[first]--;

            for (int second = 0; second &lt;= 9; second++) {
                if (frequency[second] == 0) continue;
                frequency[second]--;

                for (int third = 0; third &lt;= 8; third += 2) {
                    if (frequency[third] &gt; 0) {
                        answer++;
                    }
                }

                frequency[second]++;
            }

            frequency[first]++;
        }

        return answer;
    }
};</code></pre>
