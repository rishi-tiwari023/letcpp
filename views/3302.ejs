    <main>
        <h1>LeetCode 3302: Find the Lexicographically Smallest Valid Sequence (C++)</h1>
        <div class="problem-description">
            <p><strong>Problem:</strong>
                You are given two strings word1 and word2. A valid sequence is an array of indices into word1, in
                increasing order, such that concatenating the corresponding characters equals word2 with at most one
                character mismatch allowed. Return the lexicographically smallest valid sequence of indices, or an empty
                array if none exists.
            </p>
            <p><strong>Example:</strong>
                Input: word1 = "vbcca", word2 = "abc"<br>
                Output: [0,1,2]<br>
                Explanation: Changing word1[0] from 'v' to 'a' allows the sequence at indices 0,1,2 to match "abc" with
                exactly one mismatch allowed.
            </p>
        </div>
        <div class="code-container">
            <button class="copy-button" onclick="copyCode(this)">Copy Code</button>
            <pre><code class="language-cpp">class Solution {
public:
    vector&lt;int&gt; validSequence(string word1, string word2) {
        int m = word2.size();
        vector&lt;int&gt; lastPos(m, -1);
        int ptr = m - 1;
        for (int i = word1.size() - 1; i &gt;= 0; i--) {
            if (ptr &gt;= 0 &amp;&amp; word1[i] == word2[ptr]) {
                lastPos[ptr] = i;
                ptr--;
            }
        }
        int modified = 0;
        int target = 0;
        vector&lt;int&gt; result;
        for (int i = 0; i &lt; word1.size(); i++) {
            if (target &gt;= m) {
                break;
            }
            if (word1[i] == word2[target]) {
                result.push_back(i);
                target++;
            }
            else if (!modified) {
                if (target == m - 1 ||
                    i + 1 &lt;= lastPos[target + 1]) {
                    modified = 1;
                    result.push_back(i);
                    target++;
                }
            }
        }
        return target == m ? result : vector&lt;int&gt;{};
    }
};</code></pre>
