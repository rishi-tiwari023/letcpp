    <main>
        <h1>LeetCode 3505: Minimum Operations to Make Elements Within K Subarrays Equal (C++)</h1>
        <div class="problem-description">
            <p><strong>Problem:</strong>
                You are given an integer array nums and two integers, x and k. In one operation, you can
                increase or decrease any single element of nums by 1. Return the minimum number of
                operations needed so that nums contains at least k non-overlapping subarrays of exactly
                length x, where all elements within each such subarray are equal.
            </p>
            <p><strong>Example:</strong>
                Input: nums = [5,-2,1,3,7,3,6,4,-1], x = 3, k = 2<br>
                Output: 8<br>
                Explanation: Make indices 1 to 3 all equal to 1 by raising -2 by 3 and lowering 3 by 2,
                which costs 5 operations. Make indices 5 to 7 all equal to 4 by raising 3 by 1 and lowering
                6 by 2, which costs 3 operations. The total is 8 operations.
            </p>
        </div>
        <div class="code-container">
            <button class="copy-button" onclick="copyCode(this)">Copy Code</button>
            <pre><code class="language-cpp">class Window {
    multiset&lt;int&gt; values;
    multiset&lt;int&gt;::iterator median;
    long long leftSum, totalSum;
    int isOdd;

public:
    Window(vector&lt;int&gt;::const_iterator first, vector&lt;int&gt;::const_iterator last)
        : values(first, last), isOdd(values.size() &amp; 1) {
        median = next(values.begin(), values.size() / 2);
        leftSum = accumulate(values.begin(), median, 0LL);
        totalSum = accumulate(values.begin(), values.end(), 0LL);
    }

    long long cost() const {
        return totalSum - 2 * leftSum - isOdd * *median;
    }

    long long slide(int outgoing, int incoming) {
        values.insert(incoming);

        if (incoming &lt; *median)
            leftSum += incoming - *--median;

        if (outgoing &lt; *median) {
            leftSum += *median++ - outgoing;
            values.erase(values.find(outgoing));
        }
        else if (outgoing == *median) {
            median = values.erase(median);
        }
        else {
            values.erase(values.find(outgoing));
        }

        totalSum += incoming - outgoing;
        return cost();
    }
};

class Solution {
public:
    long long minOperations(vector&lt;int&gt;&amp; nums, int x, int k) {
        int n = nums.size();

        Window window(nums.begin(), nums.begin() + x);
        vector&lt;long long&gt; costs{window.cost()};

        for (int i = x; i &lt; n; i++)
            costs.push_back(window.slide(nums[i - x], nums[i]));

        vector&lt;long long&gt; dp(n + 1);

        for (int count = 0; count &lt; k; count++) {
            vector&lt;long long&gt; nextDp(n + 1, LLONG_MAX / 2);

            for (int i = x; i &lt;= n; i++)
                nextDp[i] = min(nextDp[i - 1], dp[i - x] + costs[i - x]);

            dp = move(nextDp);
        }

        return dp[n];
    }
};</code></pre>
