    <main>
        <h1>LeetCode 2916: Subarrays Distinct Element Sum of Squares II (C++)</h1>
        <div class="problem-description">
            <p><strong>Problem:</strong>
                You are given a 0-indexed integer array nums. The distinct count of a subarray of nums is
                defined as the number of distinct values present in that subarray. Return the sum of the
                squares of the distinct counts of all subarrays of nums. Since the answer may be very large,
                return it modulo 10^9 + 7. A subarray is a contiguous non-empty sequence of elements within
                an array. This version allows n up to 10^5, so a brute-force enumeration of all subarrays is
                too slow.
            </p>
            <p><strong>Example:</strong>
                Input: nums = [1,2,1]<br>
                Output: 15<br>
                Explanation: The six subarrays are [1], [2], [1], [1,2], [2,1], and [1,2,1]. Their distinct
                counts are 1, 1, 1, 2, 2, and 2, so the sum of squares is 1 + 1 + 1 + 4 + 4 + 4 = 15.
            </p>
        </div>
        <div class="code-container">
            <button class="copy-button" onclick="copyCode(this)">Copy Code</button>
            <pre><code class="language-cpp">class Solution {
public:
    int sumCounts(vector&lt;int&gt;&amp; nums) {
        const long long MOD = 1e9 + 7;
        int n = nums.size();
        vector&lt;long long&gt; bitCnt(n + 1), bitSum(n + 1);
        unordered_map&lt;int, int&gt; prev;
        long long ans = 0;

        for (int right = 0; right &lt; n; right++) {
            int pos = prev.count(nums[right]) ? prev[nums[right]] : -1;
            long long cnt = 0, sum = 0;

            for (int i = n - pos - 1; i &gt; 0; i -= i &amp; -i) {
                cnt += bitCnt[i];
                sum += bitSum[i];
            }

            long long add = 1LL * (right - pos) * (right - pos) - 2 * (sum - pos * cnt);
            ans = (ans + (n - right) * add) % MOD;

            for (int i = n - pos; i &lt;= n; i += i &amp; -i) {
                bitCnt[i]++;
                bitSum[i] += pos;
            }

            prev[nums[right]] = right;
        }

        return ans;
    }
};</code></pre>
