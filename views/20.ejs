        <h1>LeetCode 20: Valid Parentheses (C++)</h1>
        <div class="problem-description">
            <p><strong>Problem:</strong>
                Given a string s containing only the characters '(', ')', '{', '}', '[' and ']', determine whether
                the input string is valid. An input string is valid when each opening bracket is closed by the same
                type of bracket, brackets are closed in the correct order, and every closing bracket has a matching
                opening bracket.
            </p>
            <p><strong>Examples:</strong><br>
                Input: s = "()"<br>
                Output: true<br><br>
                Input: s = "()[]{}"<br>
                Output: true<br><br>
                Input: s = "(]"<br>
                Output: false<br><br>
                Input: s = "([])"<br>
                Output: true<br><br>
                Input: s = "([)]"<br>
                Output: false
            </p>
        </div>
        <div class="code-container">
            <button class="copy-button" onclick="copyCode(this)">Copy Code</button>
            <pre><code class="language-cpp">class Solution {
public:
    bool isValid(string str) {
        stack&lt;char&gt; brackets;

        for (int pos = 0; pos &lt; str.length(); pos++) {
            if (str[pos] == '(' || str[pos] == '{' || str[pos] == '[') {
                brackets.push(str[pos]);
            } else if (brackets.empty()) {
                return false;
            } else if (str[pos] == ')' &amp;&amp; brackets.top() == '(') {
                brackets.pop();
            } else if (str[pos] == '}' &amp;&amp; brackets.top() == '{') {
                brackets.pop();
            } else if (str[pos] == ']' &amp;&amp; brackets.top() == '[') {
                brackets.pop();
            } else {
                return false;
            }
        }

        return brackets.empty();
    }
};</code></pre>
