    <main>
        <h1>LeetCode 1267: Count Servers that Communicate (C++)</h1>
        <div class="problem-description">
            <p><strong>Problem:</strong>
                You are given a map of a server center, represented as a m * n integer matrix grid, where 1
                means that on that cell there is a server and 0 means that it is no server. Two servers are
                said to communicate if they are on the same row or on the same column. Return the number of
                servers that communicate with any other server.
            </p>
            <p><strong>Example:</strong>
                Input: grid = [[1,0],[1,1]]<br>
                Output: 3<br>
                Explanation: All three servers can communicate with at least one other server.
            </p>
        </div>
        <div class="code-container">
            <button class="copy-button" onclick="copyCode(this)">Copy Code</button>
            <pre><code class="language-cpp">class Solution {
public:
    int countServers(vector&lt;vector&lt;int&gt;&gt;&amp; grid) {
        int r = grid.size(), c = grid[0].size();
        vector&lt;int&gt; rc(r, 0), cc(c, 0);

        for (int i = 0; i &lt; r; i++) {
            for (int j = 0; j &lt; c; j++) {
                if (grid[i][j]) {
                    rc[i]++;
                    cc[j]++;
                }
            }
        }

        int res = 0;
        for (int i = 0; i &lt; r; i++) {
            for (int j = 0; j &lt; c; j++) {
                if (grid[i][j] &amp;&amp; (rc[i] &gt; 1 || cc[j] &gt; 1)) {
                    res++;
                }
            }
        }

        return res;
    }
};</code></pre>
