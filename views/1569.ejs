    <main>
        <h1>LeetCode 1569: Number of Ways to Reorder Array to Get Same BST (C++)</h1>
        <div class="problem-description">
            <p><strong>Problem:</strong>
                Given an array nums that represents a permutation of integers from 1 to n, we construct a
                binary search tree (BST) by inserting the elements of nums in order into an initially empty
                BST. Find the number of different ways to reorder nums so that the constructed BST is
                identical to that formed from the original array nums. Return the number of ways modulo
                10^9 + 7. The original ordering itself is counted as one of the ways, so the answer excludes
                it by subtracting one.
            </p>
            <p><strong>Example:</strong>
                Input: nums = [2,1,3]<br>
                Output: 1<br>
                Explanation: We can reorder nums to be [2,3,1], which will yield the same BST. There are no
                other ways to reorder nums which will yield the same BST.
            </p>
        </div>
        <div class="code-container">
            <button class="copy-button" onclick="copyCode(this)">Copy Code</button>
            <pre><code class="language-cpp">class Solution {
    const long long MOD = 1e9 + 7;
    vector&lt;vector&lt;long long&gt;&gt; comb;

    long long solve(vector&lt;int&gt;&amp; arr) {
        int n = arr.size();
        if (n &lt;= 2) return 1;

        vector&lt;int&gt; left, right;
        for (int i = 1; i &lt; n; i++) {
            if (arr[i] &lt; arr[0]) left.push_back(arr[i]);
            else right.push_back(arr[i]);
        }

        return comb[n - 1][left.size()] * solve(left) % MOD * solve(right) % MOD;
    }

public:
    int numOfWays(vector&lt;int&gt;&amp; nums) {
        int n = nums.size();
        comb.assign(n + 1, vector&lt;long long&gt;(n + 1, 0));

        for (int i = 0; i &lt;= n; i++) {
            comb[i][0] = 1;
            for (int j = 1; j &lt;= i; j++) {
                comb[i][j] = (comb[i - 1][j - 1] + comb[i - 1][j]) % MOD;
            }
        }

        return (solve(nums) - 1 + MOD) % MOD;
    }
};</code></pre>
