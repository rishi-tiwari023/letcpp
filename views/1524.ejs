        <h1>LeetCode 1524: Number of Sub-arrays With Odd Sum (C++)</h1>
        <div class="problem-description">
            <p><strong>Problem:</strong>
                Given an array of integers arr, return the number of subarrays with an odd sum. Since the
                answer can be very large, return it modulo 10^9 + 7.
            </p>
            <p><strong>Example:</strong>
                Input: arr = [1,3,5]<br>
                Output: 4<br>
                Explanation: All subarrays are [[1],[1,3],[1,3,5],[3],[3,5],[5]]. Their sums are
                [1,4,9,3,8,5]. The odd sums are [1,9,3,5], so the answer is 4.
            </p>
        </div>
        <div class="code-container">
            <button class="copy-button" onclick="copyCode(this)">Copy Code</button>
            <pre><code class="language-cpp">class Solution {
public:
    int numOfSubarrays(vector&lt;int&gt;&amp; arr) {
        const int MOD = 1e9 + 7;
        int evenCnt = 1, oddCnt = 0;
        long long ans = 0;
        int prefix = 0;

        for (int x : arr) {
            prefix = (prefix + x) % 2;
            if (prefix == 1) {
                ans = (ans + evenCnt) % MOD;
                oddCnt++;
            } else {
                ans = (ans + oddCnt) % MOD;
                evenCnt++;
            }
        }

        return (int) ans;
    }
};</code></pre>
