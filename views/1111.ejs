    <main>
        <h1>LeetCode 1111: Maximum Nesting Depth of Two Valid Parentheses Strings (C++)</h1>
        <div class="problem-description">
            <p><strong>Problem:</strong>
                A valid parentheses string is either empty, a concatenation of two valid strings, or a valid
                string wrapped in an outer pair of parentheses. You are given a valid parentheses string seq.
                Split it into two disjoint valid parentheses subsequences, A and B, such that every character
                of seq belongs to exactly one of A or B, and the maximum nesting depth of A plus that of B is
                minimized. Return an answer array where answer[i] = 0 if seq[i] belongs to A, or 1 if it
                belongs to B. If multiple answers exist, return any of them.
            </p>
            <p><strong>Example:</strong>
                Input: seq = "(()())"<br>
                Output: [0,1,1,1,1,0]<br>
                Explanation: Splitting the characters this way produces two subsequences whose combined
                maximum depth is as small as possible.
            </p>
        </div>
        <div class="code-container">
            <button class="copy-button" onclick="copyCode(this)">Copy Code</button>
            <pre><code class="language-cpp">class Solution {
public:
    vector&lt;int&gt; maxDepthAfterSplit(string&amp; seq) {
        int size = seq.size(), depth = 0;
        vector&lt;int&gt; result(size, 0);

        for (int idx = 0; idx &lt; size; idx++) {
            char ch = seq[idx];
            depth += (ch == '(') - (ch == ')');
            result[idx] = (depth &amp; 1) ^ (ch == '(');
        }

        return result;
    }
};</code></pre>
