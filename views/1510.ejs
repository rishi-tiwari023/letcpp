    <main>
        <h1>LeetCode 1510: Stone Game IV (C++)</h1>
        <div class="problem-description">
            <p><strong>Problem:</strong>
                Alice and Bob take turns removing a non-zero perfect square number of stones from a pile of n stones,
                with Alice starting first. The player who removes the last stone wins. Both players play optimally.
                Return true if Alice wins the game.
            </p>
            <p><strong>Example:</strong>
                Input: n = 4<br>
                Output: true<br>
                Explanation: Alice can remove 4 stones (2^2) in one move, leaving 0 stones for Bob, so Alice wins
                immediately.
            </p>
        </div>
        <div class="code-container">
            <button class="copy-button" onclick="copyCode(this)">Copy Code</button>
            <pre><code class="language-cpp">class Solution {
public:
    void solve(int x, vector&lt;int&gt;&amp; memo) {
        memo[x] = 0;
        for (int j = 1; j * j &lt;= x; j++) {
            int sq = j * j;
            if (memo[x - sq] == -1)
                solve(x - sq, memo);
            if (memo[x - sq] == 0) {
                memo[x] = 1;
                break;
            }
        }
    }
    bool winnerSquareGame(int n) {
        vector&lt;int&gt; memo(n + 1, -1);
        memo[0] = 0;
        solve(n, memo);
        return memo[n];
    }
};</code></pre>
