        <h1>LeetCode 3731: Find Missing Elements (C++)</h1>
        <div class="problem-description">
            <p><strong>Problem:</strong>
                Given an array of integers arr, return a list of all integers that are missing between the minimum and
                maximum values of the array (inclusive range), sorted in ascending order.
            </p>
            <p><strong>Example:</strong>
                Input: arr = [3,7,5]<br>
                Output: [4,6]<br>
                Explanation: The range spans from 3 to 7. The values 4 and 6 are missing from the array within this
                range.
            </p>
        </div>
        <div class="code-container">
            <button class="copy-button" onclick="copyCode(this)">Copy Code</button>
            <pre><code class="language-cpp">class Solution {
public:
    vector&lt;int&gt; findMissingElements(vector&lt;int&gt;&amp; arr) {
        sort(arr.begin(), arr.end());
        vector&lt;int&gt; res;
        int len = arr.size();
        int left = arr.front();
        int right = arr.back();
        unordered_map&lt;int, int&gt; seen;
        for (int idx = 0; idx &lt; len; idx++) {
            seen[arr[idx]]++;
        }
        for (int val = left; val &lt;= right; val++) {
            if (!seen.count(val)) {
                res.push_back(val);
            }
        }
        return res;
    }
};</code></pre>
